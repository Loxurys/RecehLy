# Ambil dari Supabase: Connect > Connection string > Transaction pooler (URI)
# Jangan pakai host db.[PROJECT-REF].supabase.co — hanya IPv6 dan tidak bisa diakses dari Netlify ntah apa yang terjadi
# Database dari neon.tech juga bisa digunakan, tapi hapus &channel_binding=require
# contoh neon.tech: postgresql://<user>:<password>@<hostname>/<dbname>?sslmode=require
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
PORT=3001
