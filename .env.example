# Ambil dari Supabase: Connect > Connection string > Transaction pooler (URI)
# Jangan pakai host db.[PROJECT-REF].supabase.co — itu hanya IPv6 dan tidak bisa
# dijangkau dari Netlify Functions (error ENOTFOUND).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
PORT=3001
